{
  "manifest_version": 3,
  "name": "Web-Wide-Water",
  "version": "0.2.0",
  "description": "A living sea over any web page: whales, orcas, ships and the odd sea monster while you browse. Mischief can be switched off.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Web-Wide-Water",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "options_ui": { "page": "control/control.html", "open_in_tab": true },
  "background": { "service_worker": "src/background.js" },
  "commands": {
    "toggle-follow": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Champion: follow my cursor, or roam freely"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "run_at": "document_idle",
      "js": [
        "src/core.js",
        "src/water/engine.js",
        "src/water/refract.js",
        "src/sea/scene.js",
        "src/sea/models.js",
        "src/sea/world.js",
        "src/sea/eco.js",
        "src/sea/mischief.js",
        "src/interact.js",
        "src/creatures/prey.js",
        "src/creatures/dolphins.js",
        "src/creatures/seabirds.js",
        "src/creatures/turtle.js",
        "src/creatures/manta.js",
        "src/creatures/seals.js",
        "src/creatures/penguins.js",
        "src/creatures/orca.js",
        "src/creatures/humpback.js",
        "src/creatures/ships.js",
        "src/creatures/raft.js",
        "src/creatures/dutchman.js",
        "src/creatures/megalodon.js",
        "src/creatures/shark.js",
        "src/creatures/kraken.js",
        "src/sea/mate.js",
        "src/boot.js"
      ]
    }
  ]
}
